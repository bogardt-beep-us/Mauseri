{
  "name": "mauseri",
  "version": "1.0.0",
  "private": true,
  "description": "Mauseri - Das Geheimnis der Katzenwelt. Ein 2D-Top-down-Adventure fuer den mobilen Browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:maps": "node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/check-maps.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "check:content": "node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/check-content.mjs",
    "check": "npm run check:maps && npm run check:content && tsc --noEmit",
    "test:areas": "node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/area-test.mjs",
    "test:combat": "node scripts/combat-test.mjs",
    "test": "npm run test:smoke && npm run test:areas && npm run test:combat"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
