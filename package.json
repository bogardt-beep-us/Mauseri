{
  "name": "mauseri",
  "version": "1.0.0",
  "private": true,
  "description": "Mauseri - Das Geheimnis der Katzenwelt. Ein 2D-Top-down-Adventure fuer den mobilen Browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:maps && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:maps": "node --experimental-strip-types scripts/check-maps.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "test:smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
